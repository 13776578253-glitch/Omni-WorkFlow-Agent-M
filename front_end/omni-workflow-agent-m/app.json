{
  "expo": {
    "name": "智联",
    "slug": "omni-workflow-agent-m",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/63155f6c59539910bff9051222e54a69.png",
    "scheme": "omniworkflowagentm",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icon/63155f6c59539910bff9051222e54a69.png",
        "backgroundImage": "./assets/icon/63155f6c59539910bff9051222e54a69.png",
        "monochromeImage": "./assets/icon/63155f6c59539910bff9051222e54a69.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.cpqy.omniworkflowagentm"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "允许 Omni WorkFlow Agent 访问麦克风",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon/63155f6c59539910bff9051222e54a69.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ff6ac312-bae1-4d86-85cb-a8185c60935e"
      }
    },
    "owner": "cpqy"
  }
}

